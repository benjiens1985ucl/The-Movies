<Application x:Class="The_Movies.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:The_Movies"
             xmlns:vm="clr-namespace:The_Movies.ViewModels"
             xmlns:views="clr-namespace:The_Movies.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
            <views:MainMenuView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RegisterMovieViewModel}">
            <views:RegisterMovieView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MovieListViewModel}">
            <views:MovieListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProgramViewModel}">
            <views:ProgramView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProgramOverviewViewModel}">
            <views:ProgramOverviewView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BookingViewModel}">
            <views:BookingView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BookingListViewModel}">
            <views:BookingListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EditBookingViewModel}">
            <views:EditBookingView/>
        </DataTemplate>

    </Application.Resources>
</Application>